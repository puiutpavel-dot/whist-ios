    "rules.notIncludedText": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Schimbul de duble, „stricarea jocului” cu 3 duble și închiderea pe tablă nu sunt incluse în această versiune."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swapping pairs, calling a redeal with 3 pairs and going out straight from the rack aren't in this version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tauschen von Paaren, das Neugeben bei 3 Paaren und das Ausmachen direkt von der Bank sind in dieser Version nicht enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'échange de paires, la redistribution avec 3 paires et la fermeture directe depuis le chevalet ne sont pas inclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scambio delle coppie, la ridistribuzione con 3 coppie e la chiusura direttamente dal leggio non sono inclusi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intercambio de parejas, repartir de nuevo con 3 parejas y cerrar directamente desde el atril no están incluidos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A párok cseréje, az újraosztás 3 párnál és a közvetlenül a tartóról zárás ebben a változatban nem szerepel."
          }
        }
      }
    },
    "rules.s1": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
