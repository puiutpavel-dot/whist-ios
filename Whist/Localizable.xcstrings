          }
        }
      }
    },
    "c.r.king.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Castelul tău nu poate fi lovit până la tura ta următoare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your castle can't be hit until your next turn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Burg kann bis zu deinem nächsten Zug nicht getroffen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre château est intouchable jusqu'à votre prochain tour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo castello non può essere colpito fino al tuo prossimo turno."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu castillo no puede ser golpeado hasta tu siguiente turno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A várad a következő körödig nem található el."
          }
        }
      }
    },
    "c.r.origin.t": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jocul de curte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The playground game"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hofspiel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu de cour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco da cortile"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego de patio"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az udvari játék"
          }
        }
      }
    },
    "c.r.origin.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În curtea blocului, o echipă dărâma cu mingea un turn de pietre și încerca apoi să-l reconstruiască, în timp ce echipa cealaltă o „ardea” cu mingea. Aici, turnul e castelul tău de cărți, iar mingile sunt cărțile 8, 9 și 10."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Romanian courtyards, one team knocked down a tower of stones with a ball and then tried to rebuild it while the other team tagged them with the ball. Here the tower is your castle of cards and the balls are the 8, 9 and 10."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf rumänischen Höfen warf ein Team mit dem Ball einen Steinturm um und versuchte, ihn wieder aufzubauen, während das andere Team es mit dem Ball abwarf. Hier ist der Turm deine Kartenburg, die Bälle sind 8, 9 und 10."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les cours roumaines, une équipe abattait une tour de pierres avec une balle puis tentait de la reconstruire pendant que l'autre la visait. Ici, la tour est votre château de cartes et les balles sont les 8, 9 et 10."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nei cortili rumeni una squadra abbatteva con la palla una torre di sassi e cercava di ricostruirla mentre l'altra la colpiva. Qui la torre è il tuo castello di carte e le palle sono 8, 9 e 10."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los patios rumanos, un equipo derribaba con la pelota una torre de piedras y luego intentaba reconstruirla mientras el otro le lanzaba la pelota. Aquí la torre es tu castillo de cartas y las pelotas son el 8, el 9 y el 10."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A román udvarokon az egyik csapat labdával ledöntött egy kőtornyot, majd újraépítette, miközben a másik csapat a labdával célozta. Itt a torony a kártyavárad, a labdák pedig a 8, 9 és 10."
          }
        }
      }
    },
    "c.r.queen.t": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dama: piatra joker"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Queen: wild stone"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dame: Joker-Stein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dame : pierre joker"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La donna: pietra jolly"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dama: piedra comodín"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A dáma: joker kő"
          }
        }
      }
    },
    "c.r.queen.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dama ține loc de orice nivel lipsă. Culoarea ei contează pentru mingi, ca la orice nivel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Queen stands in for any missing level. Its colour counts for balls, like any level."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dame ersetzt jede fehlende Ebene. Ihre Farbe zählt für Bälle wie jede Ebene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dame remplace n'importe quel étage manquant. Sa couleur compte pour les balles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La donna sostituisce qualsiasi piano mancante. Il suo colore conta per le palle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dama sustituye cualquier piso que falte. Su color cuenta para las pelotas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A dáma bármelyik hiányzó szintet helyettesíti. A színe a labdáknál számít."
          }
        }
      }
    },
    "c.r.score.t": {
      "extractionState": "manual",
      "localizations": {
