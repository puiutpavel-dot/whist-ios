    "w.bid.forbidden": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împarți tu: nu poți spune %1$ld, suma licitațiilor ar fi egală cu numărul de cărți."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're the dealer: you can't bid %1$ld, or the bids would add up to the number of cards."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gibst: %1$ld ist verboten, sonst ergäbe die Summe der Ansagen die Kartenzahl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous donnez : %1$ld est interdit, sinon la somme des annonces égalerait le nombre de cartes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei il mazziere: non puoi dire %1$ld, altrimenti la somma sarebbe uguale al numero di carte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repartes tú: no puedes apostar %1$ld, la suma sería igual al número de cartas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Te osztasz: nem mondhatsz %1$ld-t, különben a bemondások összege egyenlő lenne a lapok számával."
          }
        }
      }
    },
    "w.bid.forehead": {
      "extractionState": "manual",
      "localizations": {
