    "hub.remi.desc": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Remi cu piese: etalare de 45, atu, Joker și închidere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tile rummy: 45-point opening, trump tile, Jokers and going out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rommé mit Steinen: 45 zum Auslegen, Trumpfstein, Joker, Ausmachen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rami aux tuiles : pose de 45, atout, Jokers et fermeture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramino con tessere: calata da 45, briscola, Jolly e chiusura."
          }
        },
        "es": {
