    "err.firstMeldRule": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima etalare: minim 45 de puncte și cel puțin o suită (sau o terță de 1). Ai %ld puncte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First lay-down: at least 45 points with at least one run (or a group of 1s). You have %ld points."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstes Auslegen: mindestens 45 Punkte mit mindestens einer Reihe (oder einer Gruppe aus Einsen). Du hast %ld Punkte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première pose : au moins 45 points avec au moins une suite (ou une série de 1). Vous avez %ld points."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima calata: almeno 45 punti con almeno una scala (o un gruppo di 1). Hai %ld punti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primera bajada: al menos 45 puntos con al menos una escalera (o un grupo de unos). Tienes %ld puntos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Első lerakás: legalább 45 pont, legalább egy sorral (vagy egy egyesekből álló csoporttal). Neked %ld pontod van."
          }
        }
      }
    },
    "err.firstRoundStockOnly": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În prima rundă se trage doar din grămadă."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the first round you can only draw from the pile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der ersten Runde ziehst du nur vom Stapel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au premier tour, on pioche uniquement dans la pioche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al primo giro si pesca solo dal pozzo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la primera ronda solo se roba del montón."
          }
        },
