        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The others' cards are low: you have a good chance to win the trick."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karten der anderen sind niedrig: Du hast gute Chancen auf den Stich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes des autres sont faibles : vous avez de bonnes chances de faire le pli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le carte degli altri sono basse: hai buone probabilità di prendere la presa."
