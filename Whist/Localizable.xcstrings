            "value": "Añade lo que puedas y descarta una ficha."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tedd hozzá, amit tudsz, aztán dobj el egy lapkát."
          }
        }
      }
