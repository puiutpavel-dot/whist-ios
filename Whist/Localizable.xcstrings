          }
        }
      }
    },
    "rules.s7.2": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "1 în suita 1-2-3: 5 p · 1 în suita 12-13-1: 10 p · 1 în terță de 1: 25 p."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 in a 1-2-3 run: 5 pts · 1 in a 12-13-1 run: 10 pts · 1 in a group of 1s: 25 pts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 in der Reihe 1-2-3: 5 P. · 1 in der Reihe 12-13-1: 10 P. · 1 in einer Einser-Gruppe: 25 P."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 dans la suite 1-2-3 : 5 pts · 1 dans 12-13-1 : 10 pts · 1 dans une série de 1 : 25 pts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 nella scala 1-2-3: 5 pt · 1 nella scala 12-13-1: 10 pt · 1 in un gruppo di 1: 25 pt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 en la escalera 1-2-3: 5 pts · 1 en 12-13-1: 10 pts · 1 en un grupo de unos: 25 pts."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "1-es az 1-2-3 sorban: 5 p · a 12-13-1 sorban: 10 p · egyesek csoportjában: 25 p."
          }
        }
      }
    },
    "rules.s7.3": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În timpul jocului Jokerul valorează cât piesa înlocuită; la final un Joker etalat valorează 50 (Joker re-folosit: 0)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During play a Joker is worth the tile it replaces; at the end a Joker on the table counts 50 (a reused Joker counts 0)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während des Spiels zählt der Joker wie der ersetzte Stein; am Ende zählt ein ausgelegter Joker 50 (ein wiederverwendeter 0)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours de jeu, le Joker vaut la tuile remplacée ; à la fin, un Joker posé vaut 50 (un Joker réutilisé : 0)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante il gioco il Jolly vale quanto la tessera sostituita; alla fine un Jolly calato vale 50 (riutilizzato: 0)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la partida el comodín vale lo que la ficha que sustituye; al final, un comodín en la mesa vale 50 (reutilizado: 0)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Játék közben a Joker annyit ér, mint a helyettesített lapka; a végén egy lerakott Joker 50 pont (újrahasznált Joker: 0)."
          }
        }
      }
    },
    "rules.s8": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Final și punctaj"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Going out and scoring"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ende und Wertung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fin et décompte"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine e punteggio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierre y puntuación"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zárás és pontozás"
          }
        }
      }
    },
    "rules.s8.1": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Închide cine rămâne fără piese, aruncând ultima piesă în șir: +100 de puncte peste ce a etalat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You go out when you discard your last tile to the row: +100 points on top of what you laid down."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer seinen letzten Stein in die Reihe ablegt, macht aus: +100 Punkte zusätzlich zu den ausgelegten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ferme en défaussant sa dernière tuile : +100 points en plus de ce qu'on a posé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiude chi scarta l'ultima tessera nella fila: +100 punti oltre a quelli calati."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra quien descarta su última ficha en la fila: +100 puntos sobre lo que bajó."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az zár, aki az utolsó lapkáját a sorba dobja: +100 pont a lerakottakon felül."
          }
        }
      }
    },
    "rules.s8.2": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceilalți: punctele etalate minus piesele rămase pe tablă (1 = 25 p, Joker = 50 p)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone else: points laid down minus tiles left on the rack (1 = 25 pts, Joker = 50 pts)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen: ausgelegte Punkte minus Steine auf der Bank (1 = 25 P., Joker = 50 P.)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres : points posés moins les tuiles restées sur le chevalet (1 = 25 pts, Joker = 50 pts)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri: punti calati meno le tessere rimaste sul leggio (1 = 25 pt, Jolly = 50 pt)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los demás: puntos bajados menos las fichas que quedan en el atril (1 = 25 pts, comodín = 50 pts)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A többiek: lerakott pontok mínusz a tartón maradt lapkák (1-es = 25 p, Joker = 50 p)."
          }
        }
      }
    },
    "rules.s8.3": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cine nu s-a etalat deloc pierde 100 de puncte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who never laid down loses 100 points."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer gar nicht ausgelegt hat, verliert 100 Punkte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui n'a jamais posé perd 100 points."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi non ha mai calato perde 100 punti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien no ha bajado nunca pierde 100 puntos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aki egyáltalán nem rakott le, 100 pontot veszít."
          }
        }
      }
    },
    "rules.s8.4": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Închis cu Joker sau cu 1: rezultatul celui care închide se dublează."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Going out with a Joker or a 1 doubles that player's score."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer mit einem Joker oder einer 1 ausmacht, bekommt doppelte Punkte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer avec un Joker ou un 1 double le score de celui qui ferme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudere con un Jolly o un 1 raddoppia il punteggio di chi chiude."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar con un comodín o un 1 duplica la puntuación de quien cierra."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokerrel vagy 1-essel zárva a záró játékos pontjai duplázódnak."
          }
        }
      }
    },
    "rules.s8.5": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă se termină grămada, nimeni nu primește cele 100 de puncte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the pile runs out, nobody gets the 100 points."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist der Stapel leer, bekommt niemand die 100 Punkte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la pioche est vide, personne ne reçoit les 100 points."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il pozzo finisce, nessuno prende i 100 punti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se acaba el montón, nadie se lleva los 100 puntos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha elfogy a halom, senki sem kapja meg a 100 pontot."
          }
        }
      }
    },
