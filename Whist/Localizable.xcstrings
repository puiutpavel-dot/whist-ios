    "err.addNeedsOpen": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți lipi la formațiile de pe masă doar din tura de după prima etalare."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add to melds on the table from the turn after you first lay down."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlegen darfst du erst ab dem Zug nach deinem ersten Auslegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez compléter les combinaisons à partir du tour qui suit votre première pose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi attaccare alle combinazioni dal turno dopo la prima calata."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes añadir a las combinaciones desde el turno siguiente a tu primera bajada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az asztalon lévő kombinációkhoz az első lerakás utáni körtől tehetsz."
          }
        }
      }
    },
    "err.alreadyDrew": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai luat deja o piesă în tura asta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've already taken a tile this turn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast in diesem Zug schon einen Stein genommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà pris une tuile ce tour-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già preso una tessera in questo turno."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya has cogido una ficha en este turno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ebben a körben már vettél fel lapkát."
          }
        }
      }
    },
    "err.atuCloseNow": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai luat atuul: trebuie să închizi în tura asta (să-ți rămână doar piesa de închidere)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You took the trump tile: you must go out this turn, keeping only the closing tile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Trumpf genommen: Du musst in diesem Zug ausmachen und nur den letzten Stein behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez pris l'atout : vous devez fermer ce tour-ci, avec seulement la tuile de fermeture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai preso la briscola: devi chiudere in questo turno, tenendo solo la tessera di chiusura."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has cogido el triunfo: debes cerrar este turno y quedarte solo con la ficha de cierre."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felvetted az adut: ebben a körben zárnod kell, csak a záró lapka maradhat."
          }
        }
      }
    },
    "err.atuMustClose": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atuul se ia doar dacă faci formație cu el și închizi în aceeași tură."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can take the trump tile only if you meld it and go out in the same turn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Trumpf darfst du nur nehmen, wenn du ihn auslegst und im selben Zug ausmachst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'atout ne se prend que si vous le posez et fermez dans le même tour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La briscola si prende solo se la cali e chiudi nello stesso turno."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El triunfo solo se coge si lo bajas y cierras en el mismo turno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adut csak akkor veheted fel, ha kombinációba teszed és ugyanabban a körben zársz."
          }
        }
      }
    },
    "err.atuTaken": {
      "extractionState": "manual",
