    },
    "w.r1.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "3–6 jucători, fiecare pe cont propriu. Se folosesc câte 8 cărți pentru fiecare jucător: 24 la 3 jucători, 32 la 4, până la 48 la 6. Ordinea cărților: A, K, Q, J, 10, 9 și așa mai departe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3–6 players, each on their own. The deck has 8 cards per player: 24 for 3 players, 32 for 4, up to 48 for 6. Card order: A, K, Q, J, 10, 9 and so on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3–6 Spieler, jeder für sich. Pro Spieler 8 Karten: 24 bei 3 Spielern, 32 bei 4, bis 48 bei 6. Rangfolge: A, K, D, B, 10, 9 usw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 à 6 joueurs, chacun pour soi. 8 cartes par joueur : 24 à 3, 32 à 4, jusqu'à 48 à 6. Ordre : A, R, D, V, 10, 9, etc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3–6 giocatori, ognuno per sé. 8 carte per giocatore: 24 in 3, 32 in 4, fino a 48 in 6. Ordine: A, K, Q, J, 10, 9 e così via."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3–6 jugadores, cada uno por su cuenta. 8 cartas por jugador: 24 con 3, 32 con 4, hasta 48 con 6. Orden: A, K, Q, J, 10, 9, etc."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "3–6 játékos, mindenki magáért. Játékosonként 8 lap: 3 főnél 24, 4-nél 32, 6-nál 48. Sorrend: A, K, Q, J, 10, 9 és így tovább."
          }
        }
      }
    },
    "w.r10.t": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Strategie: jocul"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strategy: play"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strategie: Spiel"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stratégie : jeu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Strategia: gioco"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrategia: juego"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Stratégia: játék"
          }
        }
      }
    },
    "w.r10.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu tăia inutil când ai deja levatele licitate. După ce ai exact cât ai spus, scapă de cărțile mari când nu poți fi forțat să iei. Butonul Cărți ieșite îți arată ce mai e în joc."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't trump needlessly once you have your tricks. When you're at your bid, dump high cards while you can't be forced to win. The Cards played button shows what's still out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trumpfe nicht unnötig, wenn deine Stiche da sind. Bei erfüllter Ansage wirf hohe Karten ab. Der Knopf Gespielte Karten zeigt, was noch im Spiel ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne coupez pas inutilement une fois vos plis faits. À votre annonce, défaussez les grosses cartes. Le bouton Cartes jouées montre ce qui reste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non tagliare inutilmente quando hai già le tue prese. Raggiunta la dichiarazione, scarta le carte alte. Il pulsante Carte uscite mostra cosa resta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No falles sin necesidad cuando ya tienes tus bazas. Al llegar a lo apostado, descarta cartas altas. El botón Cartas jugadas muestra lo que queda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne üss feleslegesen, ha megvannak az ütéseid. Ha elérted a bemondást, szabadulj a nagy lapoktól. A Kijátszott lapok gomb mutatja, mi van még játékban."
          }
        }
      }
    },
    "w.r11.t": {
      "extractionState": "manual",
      "localizations": {
