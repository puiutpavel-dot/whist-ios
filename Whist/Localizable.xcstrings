    "r.rules.play.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide cel care a ales jocul. Ești obligat să răspunzi la culoare; dacă n-o ai, dai orice carte. Nu există atu: levata o ia cea mai mare carte din culoarea cerută."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chooser leads. You must follow suit; if you can't, play anything. There are no trumps: the highest card of the suit led wins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer gewählt hat, spielt aus. Farbe muss bedient werden, sonst beliebig. Es gibt keinen Trumpf: die höchste Karte der ausgespielten Farbe gewinnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui a choisi entame. Il faut fournir, sinon on joue ce qu'on veut. Pas d'atout : la plus forte carte de la couleur demandée gagne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre chi ha scelto. Si deve rispondere al seme, altrimenti qualsiasi carta. Niente briscola: vince la carta più alta del seme d'uscita."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale quien ha elegido. Hay que asistir; si no, cualquier carta. No hay triunfo: gana la carta más alta del palo de salida."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aki választott, az hív. Színre színt kell adni, ha nincs, bármit. Nincs adu: a hívott szín legnagyobb lapja viszi."
          }
        }
      }
    },
    "r.rules.queens": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare damă luată în levate: −%ld. Mâna se termină când au ieșit toate damele."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each queen you take in tricks: −%ld. The hand ends when all queens have been played."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Dame in deinen Stichen: −%ld. Die Runde endet, wenn alle Damen gefallen sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque dame prise dans vos plis : −%ld. La donne s'arrête quand toutes les dames sont tombées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni donna presa: −%ld. La mano finisce quando sono uscite tutte le donne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dama en tus bazas: −%ld. La mano termina cuando han salido todas las damas."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden elvitt dáma: −%ld. A leosztás véget ér, ha minden dáma kijött."
          }
        }
      }
    },
    "r.rules.rentz": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pun cărți pe masă pe rânduri, câte unul pentru fiecare culoare. Un rând începe cu valetul, apoi crește în sus (dama, popa, asul) și în jos (10, 9…). Poți pune un valet sau o carte lângă capătul unui rând. Dacă n-ai ce pune, treci. Asul îți dă încă o mutare, iar cea mai mică carte îl face pe următorul să stea o tură. Locurile: %1$ld, %2$ld, %3$ld, %4$ld, %5$ld de puncte; ultimul ia 0."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards are laid in rows, one per suit. A row starts with the jack and grows up (queen, king, ace) and down (10, 9…). You may play a jack or a card next to either end of a row; if you can't, you pass. An ace gives you another move, and the lowest card makes the next player miss a turn. Places score %1$ld, %2$ld, %3$ld, %4$ld, %5$ld; last place gets 0."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Karten werden in Reihen ausgelegt, eine pro Farbe. Eine Reihe beginnt mit dem Buben und wächst nach oben (Dame, König, Ass) und nach unten (10, 9…). Du legst einen Buben oder eine Karte an ein Reihenende, sonst passt du. Ein Ass gibt einen weiteren Zug, die niedrigste Karte lässt den Nächsten aussetzen. Plätze: %1$ld, %2$ld, %3$ld, %4$ld, %5$ld; der Letzte 0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes sont posées en rangées, une par couleur. Une rangée commence par le valet et s'étend vers le haut (dame, roi, as) et vers le bas (10, 9…). On pose un valet ou une carte au bout d'une rangée, sinon on passe. Un as donne un coup de plus, la plus petite carte fait passer son tour au suivant. Places : %1$ld, %2$ld, %3$ld, %4$ld, %5$ld ; le dernier 0."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le carte si dispongono in file, una per seme. Una fila parte dal fante e cresce verso l'alto (donna, re, asso) e verso il basso (10, 9…). Puoi mettere un fante o una carta accanto a un'estremità; se non puoi, passi. L'asso dà un'altra mossa, la carta più bassa fa saltare il turno al successivo. Posti: %1$ld, %2$ld, %3$ld, %4$ld, %5$ld; l'ultimo 0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cartas se colocan en filas, una por palo. Una fila empieza con la sota y crece hacia arriba (dama, rey, as) y hacia abajo (10, 9…). Puedes poner una sota o una carta junto a un extremo; si no puedes, pasas. El as da otro movimiento y la carta más baja hace que el siguiente pierda turno. Puestos: %1$ld, %2$ld, %3$ld, %4$ld, %5$ld; el último 0."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A lapok sorokba kerülnek, színenként egy sorba. A sor a bubival indul, és felfelé (dáma, király, ász) és lefelé (10, 9…) nő. Bubit vagy egy sor végéhez illő lapot tehetsz; ha nem tudsz, passzolsz. Az ász újabb lépést ad, a legkisebb lap miatt a következő kimarad. Helyezések: %1$ld, %2$ld, %3$ld, %4$ld, %5$ld; az utolsó 0."
          }
        }
      }
    },
    "r.rules.tenOfClubs": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cine ia zecele de treflă câștigă %ld de puncte. Mâna se termină imediat ce a ieșit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever takes the ten of clubs wins %ld points. The hand ends as soon as it's been played."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer die Kreuz-Zehn nimmt, bekommt %ld Punkte. Die Runde endet, sobald sie gefallen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui prend le dix de trèfle gagne %ld points. La donne s'arrête dès qu'il est tombé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi prende il dieci di fiori vince %ld punti. La mano finisce appena è uscito."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien se lleve el diez de tréboles gana %ld puntos. La mano termina en cuanto sale."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aki elviszi a treff tízest, %ld pontot nyer. A leosztás véget ér, amint kijött."
          }
        }
      }
    },
