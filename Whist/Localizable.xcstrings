    "w.coach.foreheadBad": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel puțin un adversar are o carte care te bate probabil."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one opponent probably holds a card that beats yours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens ein Gegner hat wahrscheinlich eine Karte, die deine schlägt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins un adversaire a probablement une carte qui bat la vôtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno un avversario ha probabilmente una carta che batte la tua."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos un rival tiene probablemente una carta que gana a la tuya."
