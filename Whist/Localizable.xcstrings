    "c.hint": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Construiești de la As la 7. Mingile (8, 9, 10) dărâmă nivelul de sus de aceeași culoare."
          }
        },
        "en": {
          "stringUnit": {
