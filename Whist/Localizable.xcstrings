          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque carreau pris dans vos plis : −%ld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni carta di quadri presa: −%ld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada diamante en tus bazas: −%ld."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden elvitt káró: −%ld."
          }
        }
      }
    },
