    "w.menu.coachText": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îți sugerează licitația, cu explicație, și cartea de jucat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggests your bid, with a reason, and the card to play"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlägt Ansage mit Begründung und die zu spielende Karte vor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggère l'annonce, avec explication, et la carte à jouer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerisce la dichiarazione, con spiegazione, e la carta da giocare"
