    "r.rules.totals": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate penalizările odată: popa roșu, damele, carourile și levatele. Dama de caro se socotește și damă, și caro."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All penalties at once: king of hearts, queens, diamonds and tricks. The queen of diamonds counts as both a queen and a diamond."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Minusspiele auf einmal: Herzkönig, Damen, Karos und Stiche. Die Karo-Dame zählt als Dame und als Karo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les pénalités à la fois : roi de cœur, dames, carreaux et plis. La dame de carreau compte comme dame et comme carreau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le penalità insieme: re di cuori, donne, quadri e prese. La donna di quadri conta come donna e come quadri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las penalizaciones a la vez: rey de corazones, damas, diamantes y bazas. La dama de diamantes cuenta como dama y como diamante."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden büntetés egyszerre: kőr király, dámák, kárók és ütések. A káró dáma dámának és kárónak is számít."
          }
        }
      }
    },
    "r.rules.totalsPlus": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ca la Totale, dar toate valorile sunt cu plus: popa roșu, damele, carourile și levatele aduc puncte. Acum vrei să iei cât mai mult."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like Totals, but every value is positive: the king of hearts, queens, diamonds and tricks all score for you. Now you want to take as much as possible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie „Alles“, aber alle Werte sind positiv: Herzkönig, Damen, Karos und Stiche bringen Punkte. Jetzt willst du möglichst viel nehmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme Totale, mais toutes les valeurs sont positives : roi de cœur, dames, carreaux et plis rapportent des points. Cette fois, prenez le plus possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come Totale, ma tutti i valori sono positivi: re di cuori, donne, quadri e prese danno punti. Ora vuoi prendere il più possibile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como Totales, pero todos los valores son positivos: el rey de corazones, las damas, los diamantes y las bazas suman. Ahora quieres llevarte lo máximo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mint az Összes, de minden érték pozitív: a kőr király, a dámák, a kárók és az ütések pontot érnek. Most minél többet akarsz vinni."
          }
        }
      }
    },
    "r.rules.tricks": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare levată luată: −%ld. Scopul e să iei cât mai puține."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each trick you take: −%ld. Take as few as you can."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Stich: −%ld. Mach so wenige wie möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque pli : −%ld. Faites-en le moins possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni presa: −%ld. Fanne il meno possibile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada baza: −%ld. Haz las menos posibles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden ütés: −%ld. Vigyél minél kevesebbet."
          }
        }
      }
    },
    "r.rules.whist": {
