    "hub.avioane.desc": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Clasicul din bancă: îți ascunzi avioanele și le vânezi pe ale lui. Contra botului sau online."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The school-desk classic: hide your planes, hunt theirs. Against the bot or online."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Klassiker von der Schulbank: Flugzeuge verstecken, gegnerische jagen. Gegen den Bot oder online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classique des bancs d'école : cachez vos avions, traquez les siens. Contre le bot ou en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il classico dei banchi di scuola: nascondi i tuoi aerei, caccia i suoi. Contro il bot o online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El clásico del pupitre: esconde tus aviones y caza los suyos. Contra el bot u online."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iskolapad klasszikusa: rejtsd el a repülőidet, vadászd le az övéit. A bot ellen vagy online."
          }
        }
      }
    },
