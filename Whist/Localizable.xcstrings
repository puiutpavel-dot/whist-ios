    "c.r.score.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Runda se termină când cineva își ridică toate cele 7 niveluri. Fiecare primește câte un punct pe nivel, iar câștigătorul rundei încă %1$ld. Câștigă partida primul ajuns la %2$ld puncte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A round ends when someone completes all 7 levels. Everyone scores one point per level, and the round winner %1$ld more. First to %2$ld points wins the match."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Runde endet, wenn jemand alle 7 Ebenen hat. Jeder erhält einen Punkt pro Ebene, der Rundensieger %1$ld mehr. Wer zuerst %2$ld Punkte hat, gewinnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une manche finit quand quelqu'un a ses 7 étages. Chacun marque un point par étage, le gagnant %1$ld de plus. Le premier à %2$ld points gagne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il round finisce quando qualcuno completa i 7 piani. Ognuno prende un punto per piano, il vincitore altri %1$ld. Vince chi arriva prima a %2$ld punti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ronda termina cuando alguien completa los 7 pisos. Cada uno suma un punto por piso y el ganador %1$ld más. Gana quien llegue antes a %2$ld puntos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kör akkor ér véget, ha valaki mind a 7 szintet felépíti. Szintenként 1 pont jár, a kör győztesének még %1$ld. Aki elsőként eléri a %2$ld pontot, nyer."
          }
        }
      }
    },
    "c.r.setup.t": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jucători și cărți"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Players and cards"
          }
        },
        "de": {
          "stringUnit": {
