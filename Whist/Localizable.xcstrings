    "hub.castel.desc": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridică-ți castelul de la As la 7. Dărâmă-l pe al lor cu mingea: 8, 9, 10."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build your castle from Ace to 7. Knock theirs down with the ball: 8, 9, 10."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bau deine Burg vom Ass bis zur 7. Wirf ihre mit dem Ball um: 8, 9, 10."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bâtis ton château de l'As au 7. Abats le leur avec la balle : 8, 9, 10."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci il castello dall'Asso al 7. Abbatti il loro con la palla: 8, 9, 10."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Construye tu castillo del As al 7. Derriba el suyo con la pelota: 8, 9, 10."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Építsd fel a várad ásztól 7-ig. Döntsd le az övékét a labdával: 8, 9, 10."
          }
        }
      }
    },
    "hub.footer": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cărțile le joci împotriva calculatorului; Avioane și online, prin Game Center. Fără reclame, fără cont, fără date colectate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card games are played against the computer; Avioane also online, via Game Center. No ads, no account, no data collected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartenspiele spielst du gegen den Computer, Avioane auch online über Game Center. Keine Werbung, kein Konto, keine Daten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeux de cartes se jouent contre l'ordinateur ; Avioane aussi en ligne, via Game Center. Sans pub, sans compte, sans données collectées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giochi di carte si giocano contro il computer; Avioane anche online, tramite Game Center. Niente pubblicità, niente account, nessun dato raccolto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cartas se juegan contra el ordenador; Avioane también online, con Game Center. Sin anuncios, sin cuenta, sin datos recogidos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kártyajátékokat a gép ellen játszod, az Avioane-t online is, a Game Centeren át. Reklám, fiók és adatgyűjtés nélkül."
          }
        }
      }
    },
