    "w.r9.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numără sigur doar așii și atuurile mari. Un rege fără as în aceeași culoare e o levată doar pe jumătate. Când împarți tu, gândește-te din timp la numărul interzis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count only aces and high trumps as sure tricks. A king without the ace of its suit is only half a trick. When you deal, think ahead about the forbidden number."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zähle nur Asse und hohe Trümpfe sicher. Ein König ohne Ass ist nur ein halber Stich. Als Geber denke früh an die verbotene Zahl."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne comptez sûrs que les as et les gros atouts. Un roi sans l'as n'est qu'un demi-pli. Quand vous donnez, pensez au nombre interdit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta sicuri solo assi e briscole alte. Un re senza l'asso è mezza presa. Quando fai il mazziere, pensa prima al numero vietato."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta seguros solo ases y triunfos altos. Un rey sin el as es media baza. Cuando repartas, piensa antes en el número prohibido."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Biztosnak csak az ászokat és a nagy adukat számold. Ász nélküli király csak fél ütés. Osztóként előre gondolj a tiltott számra."
          }
        }
      }
    },
