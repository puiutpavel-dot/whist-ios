    "c.r.turn.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tragi o carte din pachet, apoi joci una (construiești, arunci o minge sau pui scutul) sau arunci una. Atinge o carte ca să vezi ce poți face cu ea."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a card, then play one (build, throw a ball or raise a shield) or discard one. Tap a card to see what you can do with it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe eine Karte, dann spiele eine (bauen, Ball werfen, Schild) oder lege eine ab. Tippe eine Karte an, um die Möglichkeiten zu sehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piochez une carte, puis jouez-en une (construire, lancer une balle, bouclier) ou défaussez-en une. Touchez une carte pour voir les options."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Peschi una carta, poi ne giochi una (costruisci, lanci una palla o alzi lo scudo) o ne scarti una. Tocca una carta per vedere le opzioni."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Robas una carta y juegas una (construir, lanzar una pelota o escudo) o descartas una. Toca una carta para ver qué puedes hacer."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzol egy lapot, majd kijátszol egyet (építés, labda, pajzs) vagy eldobsz egyet. Koppints egy lapra a lehetőségekért."
          }
        }
      }
    },
