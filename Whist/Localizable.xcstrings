    },
    "rules.s7.1": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "2–9: 5 puncte · 10–13: 10 puncte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2–9: 5 points · 10–13: 10 points."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2–9: 5 Punkte · 10–13: 10 Punkte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2–9 : 5 points · 10–13 : 10 points."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "2–9: 5 punti · 10–13: 10 punti."
          }
        },
        "es": {
