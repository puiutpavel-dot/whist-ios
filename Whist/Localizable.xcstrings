    "c.r.build.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Castelul are 7 niveluri și se ridică în ordine: As, 2, 3, 4, 5, 6, 7, de orice culoare. Poți pune doar nivelul următor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The castle has 7 levels, built in order: Ace, 2, 3, 4, 5, 6, 7, any suit. You can only add the next level."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Burg hat 7 Ebenen in fester Reihenfolge: Ass, 2, 3, 4, 5, 6, 7, beliebige Farbe. Nur die nächste Ebene darf gelegt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le château a 7 étages, dans l'ordre : As, 2, 3, 4, 5, 6, 7, toutes couleurs. Seul l'étage suivant peut être posé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il castello ha 7 piani, in ordine: Asso, 2, 3, 4, 5, 6, 7, di qualsiasi seme. Puoi aggiungere solo il piano successivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El castillo tiene 7 pisos, en orden: As, 2, 3, 4, 5, 6, 7, de cualquier palo. Solo puedes poner el siguiente."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A várnak 7 szintje van, sorrendben: ász, 2, 3, 4, 5, 6, 7, bármilyen színben. Csak a következő szintet teheted le."
          }
        }
      }
    },
