      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": " Numărul cel mai apropiat e interzis pentru tine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " The closest number is forbidden for you."
