    "status.addOnly": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipește ce poți, apoi aruncă o piesă."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add what you can, then discard a tile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg an, was du kannst, dann leg einen Stein ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complétez ce que vous pouvez, puis défaussez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attacca ciò che puoi, poi scarta una tessera."
          }
        },
        "es": {
