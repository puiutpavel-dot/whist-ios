          }
        }
      }
    },
    "c.r.setup.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "2–4 jucători, pachet de 52 de cărți. Fiecare primește 5 cărți în mână și pornește cu castelul gol."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2–4 players, a 52-card deck. Everyone gets 5 cards and starts with an empty castle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2–4 Spieler, 52 Karten. Jeder bekommt 5 Karten und beginnt mit leerer Burg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 à 4 joueurs, 52 cartes. Chacun reçoit 5 cartes et commence avec un château vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "2–4 giocatori, mazzo da 52. Ognuno riceve 5 carte e parte con il castello vuoto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2–4 jugadores, baraja de 52. Cada uno recibe 5 cartas y empieza con el castillo vacío."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "2–4 játékos, 52 lapos pakli. Mindenki 5 lapot kap, és üres várral indul."
          }
        }
      }
    },
    "c.r.title": {
