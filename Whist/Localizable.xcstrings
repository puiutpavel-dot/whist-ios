    "c.r.jack.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă ai un valet în mână când ești lovit, el oprește mingea singur și se duce la cele aruncate. Nu se joacă în tura ta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you hold a Jack when hit, it stops the ball automatically and goes to the discards. It isn't played on your turn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du einen Buben, wenn du getroffen wirst, hält er den Ball automatisch auf und wird abgelegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez un valet quand on vous vise, il arrête la balle tout seul puis part à la défausse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai un fante quando vieni colpito, ferma la palla da solo e va tra gli scarti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes una sota cuando te atacan, para la pelota sola y va a los descartes."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha bubi van a kezedben, amikor eltalálnak, magától megállítja a labdát, majd a dobott lapok közé kerül."
          }
        }
      }
    },
    "c.r.king.t": {
      "extractionState": "manual",
      "localizations": {
