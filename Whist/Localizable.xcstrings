    "r.choose.tipText": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu mâna asta pierzi cel mai puțin sau câștigi cel mai mult. Fiecare joc se alege o singură dată."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With this hand it costs you the least or earns the most. Each game can be chosen only once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesem Blatt verlierst du am wenigsten oder gewinnst am meisten. Jedes Spiel nur einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec cette main, c'est ce qui coûte le moins ou rapporte le plus. Chaque jeu une seule fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con questa mano perdi di meno o guadagni di più. Ogni gioco si sceglie una volta sola."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con esta mano es lo que menos cuesta o más da. Cada juego se elige una sola vez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel a lappal ez kerül a legkevesebbe vagy hoz a legtöbbet. Minden játék csak egyszer választható."
          }
        }
      }
    },
