    "Play with a friend or a random opponent through Game Center. Your planes stay on your phone — your opponent only learns the result of each shot.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Joacă cu un prieten sau cu un adversar aleatoriu prin Game Center. Avioanele tale rămân pe telefonul tău — adversarul află doar rezultatul fiecărei lovituri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele über Game Center mit einem Freund oder einem zufälligen Gegner. Deine Flugzeuge bleiben auf deinem Telefon — dein Gegner erfährt nur das Ergebnis jedes Schusses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue avec un ami ou un adversaire au hasard via Game Center. Tes avions restent sur ton téléphone — ton adversaire ne connaît que le résultat de chaque tir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Juega con un amigo o un rival aleatorio a través de Game Center. Tus aviones se quedan en tu teléfono: tu rival solo conoce el resultado de cada disparo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gioca con un amico o un avversario casuale tramite Game Center. I tuoi aerei restano sul tuo telefono: l'avversario conosce solo il risultato di ogni colpo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play with a friend or a random opponent through Game Center. Your planes stay on your phone — your opponent only learns the result of each shot."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Játssz egy baráttal vagy véletlen ellenféllel a Game Centeren keresztül. A repülőid a telefonodon maradnak – az ellenfeled csak az egyes lövések eredményét tudja meg."
          }
        }
      }
    },
    "Players take turns firing one shot. The answer is always one of three: 🌊 Water, 💥 Hit or ✈️ Destroyed.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jucătorii trag pe rând câte o lovitură. Răspunsul e mereu unul din trei: 🌊 Apă, 💥 Lovit sau ✈️ Distrus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spieler schießen abwechselnd einmal. Die Antwort ist immer eine von drei: 🌊 Wasser, 💥 Treffer oder ✈️ Zerstört."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les joueurs tirent chacun leur tour. La réponse est toujours l'une des trois : 🌊 À l'eau, 💥 Touché ou ✈️ Abattu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los jugadores disparan por turnos. La respuesta siempre es una de tres: 🌊 Agua, 💥 Tocado o ✈️ Derribado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giocatori sparano a turno un colpo. La risposta è sempre una di tre: 🌊 Acqua, 💥 Colpito o ✈️ Abbattuto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Players take turns firing one shot. The answer is always one of three: 🌊 Water, 💥 Hit or ✈️ Destroyed."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A játékosok felváltva lőnek egyet. A válasz mindig a három közül az egyik: 🌊 Víz, 💥 Talált vagy ✈️ Lelőve."
          }
