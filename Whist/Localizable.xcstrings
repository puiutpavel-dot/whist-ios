    "status.openFirst": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Etalează minim 45p (cu o suită), apoi aruncă."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lay down 45+ points (with a run), then discard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg mind. 45 Punkte aus (mit einer Reihe), dann ablegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez 45 pts min. (avec une suite), puis défaussez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cala almeno 45 punti (con una scala), poi scarta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja 45 puntos o más (con una escalera) y descarta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rakj le legalább 45 pontot (egy sorral), aztán dobj."
          }
