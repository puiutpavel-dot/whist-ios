    "c.r.ball.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dărâmă nivelul de sus al unui adversar, dacă are aceeași culoare cu mingea (roșu cu roșu, negru cu negru). Cartea dărâmată ajunge la cele aruncate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knocks down an opponent's top level if it has the same colour as the ball (red on red, black on black). The fallen card goes to the discards."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirft die oberste Ebene eines Gegners um, wenn sie dieselbe Farbe wie der Ball hat (rot auf rot, schwarz auf schwarz)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abat l'étage du haut d'un adversaire s'il est de la même couleur que la balle (rouge sur rouge, noir sur noir)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbatte il piano in cima di un avversario se è dello stesso colore della palla (rosso su rosso, nero su nero)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Derriba el piso de arriba de un rival si es del mismo color que la pelota (rojo con rojo, negro con negro)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ledönti egy ellenfél legfelső szintjét, ha a labdával azonos színű (piros a pirosra, fekete a feketére)."
          }
        }
      }
    },
