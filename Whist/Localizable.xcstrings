          }
        }
      }
    },
    "r.rules.end.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După ce fiecare jucător a ales toate cele 8 jocuri, câștigă cel cu cele mai multe puncte. Punctajele diferă de la o masă la alta; aplicația folosește valorile de mai sus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once every player has chosen all 8 games, the highest score wins. Point values vary from table to table; the app uses the values above."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn jeder Spieler alle 8 Spiele gewählt hat, gewinnt die höchste Punktzahl. Die Werte variieren je nach Runde; die App nutzt die obigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand chaque joueur a choisi les 8 jeux, le meilleur score gagne. Les valeurs varient selon les tables ; l'application utilise celles ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ogni giocatore ha scelto tutti gli 8 giochi, vince il punteggio più alto. I valori cambiano da tavolo a tavolo; l'app usa quelli sopra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando cada jugador ha elegido los 8 juegos, gana la puntuación más alta. Los valores varían según la mesa; la app usa los de arriba."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha mindenki kiválasztotta mind a 8 játékot, a legtöbb pont nyer. A pontértékek asztalonként eltérnek; az alkalmazás a fentieket használja."
          }
        }
      }
    },
    "r.rules.history": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Renț-ul (Rentz) e varianta românească a familiei de jocuri „Barbu” și „Herzeln”, în care fiecare mână are alt scop. E un joc de seară lungă, jucat de generații în cămine studențești și în familie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentz is the Romanian member of the Barbu / Hearts family, where every hand has a different goal. It's a long-evening game played for generations in student dorms and at family tables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentz ist die rumänische Variante der Barbu-/Herzeln-Familie, in der jede Runde ein anderes Ziel hat. Ein Spiel für lange Abende, seit Generationen in Familie und Studentenheim gespielt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Rentz est la version roumaine de la famille Barbu / Dame de pique, où chaque donne a un but différent. Un jeu de longues soirées, joué depuis des générations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Rentz è la variante rumena della famiglia Barbu / Hearts, in cui ogni mano ha uno scopo diverso. Un gioco da lunghe serate, giocato da generazioni."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Rentz es la variante rumana de la familia Barbu / Corazones, en la que cada mano tiene un objetivo distinto. Un juego de largas veladas, jugado desde hace generaciones."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Rentz a Barbu / Hearts család román változata, ahol minden leosztásnak más a célja. Hosszú esték játéka, generációk óta játsszák."
          }
        }
      }
    },
    "r.rules.kingOfHearts": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cine ia popa de inimă roșie (K♥) pierde %ld de puncte. Mâna se termină imediat ce a ieșit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever takes the king of hearts loses %ld points. The hand ends as soon as it's been played."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer den Herzkönig nimmt, verliert %ld Punkte. Die Runde endet, sobald er gefallen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui prend le roi de cœur perd %ld points. La donne s'arrête dès qu'il est tombé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi prende il re di cuori perde %ld punti. La mano finisce appena è uscito."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien se lleve el rey de corazones pierde %ld puntos. La mano termina en cuanto sale."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aki elviszi a kőr királyt, %ld pontot veszít. A leosztás véget ér, amint kijött."
          }
        }
      }
    },
    "r.rules.play.t": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Levatele"
          }
        },
        "en": {
