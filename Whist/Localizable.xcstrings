    "A plane goes down instantly if you hit its nose, or once all 10 of its squares are hit. A downed plane is shown in full on the radar.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avion cade instant dacă îl nimerești în bot sau când i-ai lovit toate cele 10 pătrățele. Avionul doborât apare întreg pe radar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Flugzeug stürzt sofort ab, wenn du seine Nase triffst, oder sobald alle 10 Felder getroffen sind. Ein abgeschossenes Flugzeug wird komplett auf dem Radar angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avion tombe instantanément si tu touches son nez, ou dès que ses 10 cases sont touchées. Un avion abattu s'affiche en entier sur le radar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avión cae al instante si le das en el morro, o cuando todas sus 10 casillas han sido tocadas. El avión derribado aparece completo en el radar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aereo cade all'istante se lo colpisci sul muso, oppure quando tutte le sue 10 caselle sono colpite. L'aereo abbattuto appare intero sul radar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A plane goes down instantly if you hit its nose, or once all 10 of its squares are hit. A downed plane is shown in full on the radar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy repülő azonnal lezuhan, ha eltalálod az orrát, vagy ha mind a 10 mezőjét eltalálták. A lelőtt repülő teljes egészében megjelenik a radaron."
          }
        }
      }
    },
