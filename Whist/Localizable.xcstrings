    "r.rules.basics.x": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "3–6 jucători, fiecare cu câte 8 cărți (la 4 jucători, de la 7 la as). La fiecare mână, alt jucător alege unul dintre cele 8 jocuri pe care nu l-a mai ales. Partida are 8 mâini pentru fiecare jucător."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3–6 players with 8 cards each (with 4 players, 7 up to ace). Each hand, another player chooses one of the 8 games they haven't chosen yet. A match has 8 hands per player."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3–6 Spieler mit je 8 Karten (zu viert von 7 bis Ass). In jeder Runde wählt ein anderer Spieler eines der 8 Spiele, das er noch nicht gewählt hat. Eine Partie hat 8 Runden pro Spieler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 à 6 joueurs, 8 cartes chacun (à 4, du 7 à l'as). À chaque donne, un autre joueur choisit l'un des 8 jeux qu'il n'a pas encore pris. Une partie compte 8 donnes par joueur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3–6 giocatori con 8 carte ciascuno (in 4, dal 7 all'asso). A ogni mano un altro giocatore sceglie uno degli 8 giochi non ancora scelti. Una partita ha 8 mani per giocatore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3–6 jugadores con 8 cartas cada uno (con 4, del 7 al as). En cada mano otro jugador elige uno de los 8 juegos que aún no ha elegido. Una partida tiene 8 manos por jugador."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "3–6 játékos, mindenkinek 8 lap (4 főnél 7-estől ászig). Minden leosztásban más választ a 8 játék közül egyet, amit még nem választott. Egy parti játékosonként 8 leosztás."
          }
        }
      }
    },
    "r.rules.diamonds": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare carte de caro luată în levate: −%ld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each diamond you take in tricks: −%ld."
          }
        },
        "de": {
