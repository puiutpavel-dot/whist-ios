    "Planes cannot overlap or leave the grid. They may touch side by side.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Avioanele nu se pot suprapune și nu pot ieși din grilă. Se pot atinge pe laturi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flugzeuge dürfen sich nicht überlappen oder das Raster verlassen. Sie dürfen sich seitlich berühren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les avions ne peuvent ni se chevaucher ni sortir de la grille. Ils peuvent se toucher par les côtés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los aviones no pueden solaparse ni salir de la cuadrícula. Pueden tocarse por los lados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli aerei non possono sovrapporsi né uscire dalla griglia. Possono toccarsi lateralmente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planes cannot overlap or leave the grid. They may touch side by side."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A repülők nem fedhetik át egymást, és nem lóghatnak ki a rácsból. Oldalról érinthetik egymást."
          }
        }
      }
    },
    "Play online": {
