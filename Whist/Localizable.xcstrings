    "All your planes are down. The enemy planes are now visible on the radar.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate avioanele tale au căzut. Avioanele inamice sunt acum vizibile pe radar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle deine Flugzeuge sind abgestürzt. Die feindlichen Flugzeuge sind jetzt auf dem Radar sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous tes avions sont tombés. Les avions ennemis sont maintenant visibles sur le radar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus aviones han caído. Los aviones enemigos ahora se ven en el radar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tuoi aerei sono caduti. Gli aerei nemici ora sono visibili sul radar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your planes are down. The enemy planes are now visible on the radar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az összes repülőd lezuhant. Az ellenfél repülői most láthatók a radaron."
          }
        }
      }
    },
    "Avioane uses your iPhone's language. To pick a different language just for this app, open its page in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Avioane folosește limba iPhone-ului tău. Ca să alegi altă limbă doar pentru această aplicație, deschide pagina ei din Configurări iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Avioane verwendet die Sprache deines iPhones. Um nur für diese App eine andere Sprache zu wählen, öffne ihre Seite in den iOS-Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avioane utilise la langue de ton iPhone. Pour choisir une autre langue uniquement pour cette app, ouvre sa page dans les Réglages iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avioane usa el idioma de tu iPhone. Para elegir otro idioma solo para esta app, abre su página en los Ajustes de iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avioane usa la lingua del tuo iPhone. Per scegliere un'altra lingua solo per questa app, apri la sua pagina nelle Impostazioni di iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avioane uses your iPhone's language. To pick a different language just for this app, open its page in iOS Settings."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Avioane az iPhone nyelvét használja. Ha csak ehhez az alkalmazáshoz szeretnél más nyelvet, nyisd meg az oldalát az iOS Beállításokban."
          }
        }
      }
    },
