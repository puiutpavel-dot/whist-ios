          }
        }
      }
    },
    "rules.s1.1": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "106 piese: numere de la 1 la 13 în patru culori (roșu, galben, albastru, negru), câte două serii, plus 2 Jokeri (Joly)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "106 tiles: numbers 1 to 13 in four colors (red, yellow, blue, black), two of each, plus 2 Jokers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "106 Steine: Zahlen von 1 bis 13 in vier Farben (Rot, Gelb, Blau, Schwarz), je zweimal, dazu 2 Joker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "106 tuiles : nombres de 1 à 13 en quatre couleurs (rouge, jaune, bleu, noir), en double, plus 2 Jokers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "106 tessere: numeri da 1 a 13 in quattro colori (rosso, giallo, blu, nero), due serie, più 2 Jolly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "106 fichas: números del 1 al 13 en cuatro colores (rojo, amarillo, azul, negro), dos de cada, y 2 comodines."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "106 lapka: 1-től 13-ig négy színben (piros, sárga, kék, fekete), mindegyikből kettő, plusz 2 Joker."
          }
        }
      }
    },
    "rules.s1.2": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se joacă în 2, 3 sau 4 jucători. Cine începe primește 15 piese, ceilalți câte 14."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2, 3 or 4 players. Whoever starts gets 15 tiles, everyone else 14."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2, 3 oder 4 Spieler. Wer beginnt, bekommt 15 Steine, alle anderen 14."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2, 3 ou 4 joueurs. Celui qui commence reçoit 15 tuiles, les autres 14."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 2, 3 o 4 giocatori. Chi inizia riceve 15 tessere, gli altri 14."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 2, 3 o 4 jugadores. Quien empieza recibe 15 fichas; los demás, 14."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "2, 3 vagy 4 játékos. Aki kezd, 15 lapkát kap, a többiek 14-et."
          }
        }
      }
    },
    "rules.s1.3": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O piesă e întoarsă la început: atuul. Dacă atuul e 1 sau Joker, toată mâna se joacă la dublu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tile is turned face up at the start: the trump. If the trump is a 1 or a Joker, the whole hand scores double."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Beginn wird ein Stein aufgedeckt: der Trumpf. Ist er eine 1 oder ein Joker, zählt das ganze Spiel doppelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tuile est retournée au début : l'atout. Si c'est un 1 ou un Joker, toute la manche compte double."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All'inizio si scopre una tessera: la briscola. Se è un 1 o un Jolly, tutta la mano vale doppio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al empezar se descubre una ficha: el triunfo. Si es un 1 o un comodín, toda la mano cuenta doble."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elején felfordítanak egy lapkát: ez az adu. Ha 1-es vagy Joker, az egész leosztás duplán számít."
          }
        }
      }
    },
    "rules.s1.4": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cine are de la început piesa identică cu atuul primește 50 de puncte la final."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever is dealt the twin of the trump tile gets 50 bonus points at the end."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer den gleichen Stein wie den Trumpf erhält, bekommt am Ende 50 Punkte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui qui reçoit la tuile identique à l'atout gagne 50 points à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi riceve la tessera gemella della briscola ottiene 50 punti alla fine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien recibe la ficha gemela del triunfo gana 50 puntos al final."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Aki megkapja az aduval azonos lapkát, a végén 50 pontot kap."
          }
        }
      }
    },
    "rules.s2": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Formațiile"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Melds"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombinationen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinaisons"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinazioni"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinaciones"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombinációk"
          }
        }
      }
    },
    "rules.s2.1": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Suită: minim 3 piese de aceeași culoare, consecutive. 1 poate sta la început (1-2-3) sau după 13 (12-13-1), dar nu mai continui cu 2."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run: 3 or more consecutive tiles of one color. A 1 can go low (1-2-3) or after 13 (12-13-1), but the run can't wrap on to 2."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reihe: mindestens 3 aufeinanderfolgende Steine einer Farbe. Die 1 steht am Anfang (1-2-3) oder nach der 13 (12-13-1), danach geht es nicht mit 2 weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suite : au moins 3 tuiles consécutives d'une même couleur. Le 1 se place au début (1-2-3) ou après 13 (12-13-1), sans continuer avec 2."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scala: almeno 3 tessere consecutive dello stesso colore. L'1 va all'inizio (1-2-3) o dopo il 13 (12-13-1), ma poi non si continua col 2."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escalera: 3 o más fichas seguidas del mismo color. El 1 va al principio (1-2-3) o tras el 13 (12-13-1), pero no se sigue con el 2."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sor: legalább 3 egymást követő, azonos színű lapka. Az 1-es lehet az elején (1-2-3) vagy a 13 után (12-13-1), de utána nem jöhet 2-es."
          }
        }
      }
    },
    "rules.s2.2": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Terță: minim 3 piese cu același număr, toate de culori diferite (maxim 4)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group: 3 or 4 tiles with the same number, all in different colors."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppe: 3 oder 4 Steine mit derselben Zahl in verschiedenen Farben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Série : 3 ou 4 tuiles du même nombre, toutes de couleurs différentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppo: 3 o 4 tessere con lo stesso numero, tutte di colori diversi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupo: 3 o 4 fichas del mismo número, todas de colores distintos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csoport: 3 vagy 4 azonos számú lapka, mind különböző színű."
          }
        }
      }
    },
    "rules.s2.3": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O formație cu un Joker are nevoie de încă 2 piese reale; cu 2 Jokeri, de încă 4 piese reale, iar Jokerii nu stau unul lângă altul."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meld with one Joker needs 2 real tiles; with 2 Jokers it needs 4 real tiles, and the Jokers can't be next to each other."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Kombination mit einem Joker braucht 2 echte Steine, mit 2 Jokern 4 echte Steine, und die Joker liegen nicht nebeneinander."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une combinaison avec un Joker demande 2 vraies tuiles ; avec 2 Jokers, 4 vraies tuiles, et les Jokers ne se touchent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una combinazione con un Jolly richiede 2 tessere vere; con 2 Jolly ne servono 4 e i Jolly non stanno vicini."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una combinación con un comodín necesita 2 fichas reales; con 2 comodines, 4 fichas reales, y los comodines no van juntos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy Jokerrel 2 valódi lapka kell a kombinációhoz, 2 Jokerrel 4, és a Jokerek nem lehetnek egymás mellett."
          }
        }
      }
    },
    "rules.s3": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tura"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your turn"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Zug"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il turno"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El turno"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kör"
          }
        }
      }
    },
    "rules.s3.1": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare tură începe prin a lua o piesă și se termină prin a arunca una în șir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every turn starts by taking a tile and ends by discarding one to the row."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Zug beginnt mit dem Nehmen eines Steins und endet mit dem Ablegen eines Steins in die Reihe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque tour commence en prenant une tuile et se termine en défaussant une tuile dans la rangée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni turno inizia prendendo una tessera e finisce scartandone una nella fila."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada turno empieza cogiendo una ficha y termina descartando una en la fila."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden kör egy lapka felvételével kezdődik és egy lapka sorba dobásával végződik."
          }
        }
      }
    },
    "rules.s3.2": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima piesă din șir stă orizontal și nu poate fi folosită de nimeni."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first tile in the row lies sideways and nobody can use it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Stein der Reihe liegt quer und darf von niemandem genommen werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première tuile de la rangée est posée en travers et personne ne peut la prendre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima tessera della fila sta di traverso e nessuno può usarla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera ficha de la fila va en horizontal y nadie puede usarla."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A sor első lapkája keresztben fekszik, és senki sem használhatja."
          }
        }
      }
    },
    "rules.s3.3": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În prima rundă doar tragi din grămadă și arunci — nu se etalează."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the first round you only draw from the pile and discard. No laying down."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der ersten Runde ziehst du nur vom Stapel und legst ab. Ausgelegt wird noch nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au premier tour, on pioche et on défausse seulement. Pas de pose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al primo giro peschi dal pozzo e scarti soltanto. Non si cala."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la primera ronda solo robas del montón y descartas. No se baja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az első körben csak húzol a halomból és dobsz. Lerakni még nem lehet."
          }
        }
      }
    },
    "rules.s4": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima etalare"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First lay-down"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstes Auslegen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première pose"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima calata"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primera bajada"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Első lerakás"
          }
        }
      }
    },
    "rules.s4.1": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din runda a doua poți etala formații care adunate fac minim 45 de puncte și conțin cel puțin o suită."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the second round you can lay down melds worth at least 45 points in total, including at least one run."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab der zweiten Runde darfst du Kombinationen mit zusammen mindestens 45 Punkten auslegen, darunter mindestens eine Reihe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès le deuxième tour, vous pouvez poser des combinaisons valant au moins 45 points, dont au moins une suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal secondo giro puoi calare combinazioni che valgono almeno 45 punti, con almeno una scala."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde la segunda ronda puedes bajar combinaciones que sumen al menos 45 puntos, con al menos una escalera."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A második körtől lerakhatsz összesen legalább 45 pontot érő kombinációkat, köztük legalább egy sorral."
          }
        }
      }
    },
    "rules.s4.2": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Excepție: te poți etala și doar cu o terță de 1."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exception: a group of 1s on its own is also enough."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausnahme: Eine Gruppe aus Einsen allein reicht auch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exception : une série de 1 suffit aussi à elle seule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eccezione: basta anche un gruppo di 1 da solo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excepción: también basta un grupo de unos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kivétel: egy egyesekből álló csoport önmagában is elég."
          }
        }
      }
    },
    "rules.s4.3": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți lua ultima piesă aruncată în șir doar dacă o folosești imediat într-o formație nouă."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can take the last discarded tile only if you use it right away in a new meld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den zuletzt abgelegten Stein darfst du nur nehmen, wenn du ihn sofort in einer neuen Kombination auslegst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez prendre la dernière tuile défaussée seulement si vous la posez aussitôt dans une nouvelle combinaison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi prendere l'ultima tessera scartata solo se la usi subito in una nuova combinazione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes coger la última ficha descartada solo si la usas enseguida en una combinación nueva."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utoljára eldobott lapkát csak akkor veheted fel, ha rögtön új kombinációba teszed."
          }
        }
      }
    },
    "rules.s5": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După etalare"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After laying down"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Auslegen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la pose"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo la calata"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de bajar"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerakás után"
          }
        }
      }
    },
    "rules.s5.1": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Din tura următoare poți lipi piese la orice formație de pe masă. Punctele piesei lipite sunt ale tale."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From your next turn you can add tiles to any meld on the table. The points for those tiles are yours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab dem nächsten Zug darfst du an jede Kombination auf dem Tisch anlegen. Die Punkte der angelegten Steine gehören dir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès le tour suivant, vous pouvez compléter n'importe quelle combinaison. Les points des tuiles ajoutées sont à vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal turno successivo puoi attaccare tessere a qualsiasi combinazione sul tavolo. I punti di quelle tessere sono tuoi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde el turno siguiente puedes añadir fichas a cualquier combinación de la mesa. Sus puntos son tuyos."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő körtől bármelyik kombinációhoz tehetsz lapkát. A hozzátett lapkák pontjai a tieid."
          }
        }
      }
    },
    "rules.s5.2": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Poți rupe șirul: iei orice piesă (în afară de prima), dacă ești etalat, ai minim 4 piese și o folosești imediat într-o formație nouă. Piesele de după ea vin pe tabla ta."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can break the row: take any tile but the first if you've laid down, have 4+ tiles and use it at once in a new meld. The tiles after it come to your rack."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du darfst die Reihe aufbrechen: einen beliebigen Stein außer dem ersten nehmen, wenn du ausgelegt hast, mindestens 4 Steine hast und ihn sofort neu auslegst. Die Steine danach kommen auf deine Bank."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez couper la rangée : prendre n'importe quelle tuile sauf la première si vous avez posé, avez 4 tuiles ou plus et la posez aussitôt. Les tuiles suivantes vont sur votre chevalet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi spezzare la fila: prendi qualsiasi tessera tranne la prima se hai calato, hai almeno 4 tessere e la usi subito in una nuova combinazione. Le tessere successive vanno sul tuo leggio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes romper la fila: coger cualquier ficha salvo la primera si ya bajaste, tienes 4 o más fichas y la usas enseguida en una combinación nueva. Las fichas posteriores van a tu atril."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megtörheted a sort: bármelyik lapkát felveheted az elsőn kívül, ha már lerakóztál, van legalább 4 lapkád, és rögtön új kombinációba teszed. Az utána következő lapkák a tartódra kerülnek."
          }
        }
      }
    },
    "rules.s5.3": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacă ai exact piesa pe care o ține locul unui Joker etalat, o poți pune în locul lui și iei Jokerul. Un Joker se poate schimba o singură dată."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you hold the exact tile a Joker on the table stands for, you can swap it in and take the Joker. Each Joker can be swapped only once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du genau den Stein, den ein ausgelegter Joker ersetzt, kannst du ihn tauschen und den Joker nehmen. Jeder Joker wird nur einmal getauscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez la tuile exacte que remplace un Joker posé, vous pouvez l'échanger et prendre le Joker. Un Joker ne s'échange qu'une fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai la tessera esatta che un Jolly calato sostituisce, puoi metterla al suo posto e prendere il Jolly. Ogni Jolly si scambia una sola volta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes la ficha exacta que sustituye un comodín de la mesa, puedes ponerla y quedarte el comodín. Cada comodín se cambia una sola vez."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha nálad van az a lapka, amelyet egy lerakott Joker helyettesít, kicserélheted, és megkapod a Jokert. Minden Joker csak egyszer cserélhető."
          }
        }
      }
    },
    "rules.s5.4": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokerul nu se lipește la formațiile altor jucători."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Joker can't be added to another player's meld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Joker werden nicht bei anderen Spielern angelegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Joker ne peut pas compléter la combinaison d'un autre joueur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Jolly non si attacca alle combinazioni degli altri giocatori."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comodín no se añade a combinaciones de otros jugadores."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokert nem lehet más játékos kombinációjához tenni."
          }
        }
      }
    },
    "rules.s6": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimele piese"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last tiles"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten Steine"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernières tuiles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultime tessere"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Últimas fichas"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az utolsó lapkák"
          }
        }
      }
    },
    "rules.s6.1": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când mai ai cel mult 3 piese, ceilalți sunt anunțați (aplicația face asta automat)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a player has 3 tiles or fewer, everyone is told (the app shows it automatically)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat jemand höchstens 3 Steine, wird es angesagt (die App zeigt es automatisch)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un joueur a 3 tuiles ou moins, tout le monde est prévenu (l'appli l'affiche)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un giocatore ha 3 tessere o meno, viene annunciato (l'app lo mostra da sola)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando a alguien le quedan 3 fichas o menos, se anuncia (la app lo muestra sola)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha valakinek legfeljebb 3 lapkája maradt, az mindenki látja (az app kiírja)."
          }
        }
      }
    },
    "rules.s6.2": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu 3 piese poți lua doar ultima piesă din șir; cu 1–2 piese tragi obligatoriu din grămadă și doar lipești."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With 3 tiles you can only take the last tile in the row; with 1–2 tiles you must draw from the pile and can only add to melds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit 3 Steinen darfst du nur den letzten Stein der Reihe nehmen; mit 1–2 Steinen ziehst du vom Stapel und legst nur noch an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec 3 tuiles, seule la dernière tuile de la rangée peut être prise ; avec 1 ou 2, on pioche et on ne fait que compléter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con 3 tessere puoi prendere solo l'ultima della fila; con 1–2 peschi dal pozzo e puoi solo attaccare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con 3 fichas solo puedes coger la última de la fila; con 1–2 robas del montón y solo puedes añadir."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "3 lapkával csak a sor utolsó lapkáját veheted fel; 1–2 lapkával húznod kell, és csak hozzátenni lehet."
          }
        }
      }
    },
    "rules.s6.3": {
      "extractionState": "manual",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atuul îl poți lua doar dacă faci formație cu el și închizi în aceeași tură."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can take the trump tile only if you meld it and go out in the same turn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Trumpf darfst du nur nehmen, wenn du ihn auslegst und im selben Zug ausmachst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'atout ne se prend que si vous le posez et fermez dans le même tour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La briscola si prende solo se la cali e chiudi nello stesso turno."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El triunfo solo se coge si lo bajas y cierras en el mismo turno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adut csak akkor veheted fel, ha kombinációba teszed és ugyanabban a körben zársz."
          }
        }
      }
    },
    "rules.s7": {
      "extractionState": "manual",
      "localizations": {
